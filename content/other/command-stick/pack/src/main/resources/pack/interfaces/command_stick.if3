[[interface]]
name = "interface.command_stick"
width = 512
height = 334
on_load = ["clientscript.command_stick_init", "component.command_stick:frame", "component.command_stick:list", "component.command_stick:scrollbar"]

[[component]]
name = "frame"
type = "layer"
width = 512
height = 334
no_click_through = true

[[component]]
name = "categories"
type = "layer"
x = 10
y = 40
width = 140
height = 248

[[component]]
name = "list"
type = "layer"
x = 156
y = 40
width = 328
height = 248
scroll_height = 248

[[component]]
name = "scrollbar"
type = "layer"
x = 486
y = 40
width = 16
height = 248

[[component]]
name = "description"
type = "text"
x = 10
y = 294
width = 492
height = 30
font = "regular"
color = "#FFFFFF"
h_align = "left"
v_align = "center"
text = "Hover over a command to see what it does."
